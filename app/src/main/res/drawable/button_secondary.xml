<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#222F6F4E">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="@color/white" />
                    <stroke android:width="1dp" android:color="@color/line" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/white" />
                    <stroke android:width="1.5dp" android:color="@color/accent" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
